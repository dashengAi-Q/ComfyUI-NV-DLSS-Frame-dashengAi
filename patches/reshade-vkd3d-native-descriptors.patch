diff --git a/source/d3d12/d3d12_impl_device.cpp b/source/d3d12/d3d12_impl_device.cpp
index b1bbfc0..54c318c 100644
--- a/source/d3d12/d3d12_impl_device.cpp
+++ b/source/d3d12/d3d12_impl_device.cpp
@@ -2322,9 +2322,17 @@ void D3D12DescriptorHeap::initialize_descriptor_base_handle(size_t heap_index)
 #endif
 
 #if RESHADE_ADDON >= 2
-D3D12_CPU_DESCRIPTOR_HANDLE reshade::d3d12::device_impl::convert_to_original_cpu_descriptor_handle(D3D12_CPU_DESCRIPTOR_HANDLE handle) const
+D3D12_CPU_DESCRIPTOR_HANDLE reshade::d3d12::device_impl::convert_to_original_cpu_descriptor_handle(D3D12_CPU_DESCRIPTOR_HANDLE handle, bool allow_original) const
 {
 	const size_t heap_index = (handle.ptr >> heap_index_start) & 0xFFFFFFF;
+	// VKD3D extension vtables are shared by wrapped and original devices.
+	// RenoDX can call them with descriptors allocated on the original device.
+	// Only CBV/SRV/UAV and sampler heaps receive ReShade virtual handles;
+	// native VKD3D descriptor tags (2/3) and pointers must pass through.
+	if (allow_original && ((handle.ptr & 0x3) > D3D12_DESCRIPTOR_HEAP_TYPE_SAMPLER ||
+		heap_index >= _descriptor_heaps.size() || _descriptor_heaps[heap_index] == nullptr))
+		return handle;
+
 	assert(heap_index < _descriptor_heaps.size() && _descriptor_heaps[heap_index] != nullptr);
 
 	return { _descriptor_heaps[heap_index]->_orig_base_cpu_handle.ptr + (handle.ptr & (((1ull << heap_index_start) - 1) ^ 0x7)) };
