# Git LFS endpoint override: the large NVIDIA runtime binaries are stored in
# this Hugging Face repository instead of GitHub, so the GitHub repo stays
# under 50 MB. git-lfs reads this file and fetches objects from Hugging Face.
#
# To point at a mirror (mainland-China fallback), change the host to
# https://hf-mirror.com/dashengAi/ComfyUI-NV-DLSS-Frame-dashengAi-runtime.git/info/lfs
[lfs]
    url = https://huggingface.co/dashengAi/ComfyUI-NV-DLSS-Frame-dashengAi-runtime.git/info/lfs
